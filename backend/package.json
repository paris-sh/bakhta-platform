{
  "name": "bakhta-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bakhta lottery platform backend API (Phase 1: project skeleton).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:rollback": "tsx scripts/rollback.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:generate-types": "tsx scripts/generate-db-types.ts",
    "test:pgtap": "tsx scripts/run-pgtap.ts",
    "test:concurrency": "tsx scripts/run-concurrency.ts"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "hash-wasm": "^4.12.0",
    "fastify-type-provider-zod": "^4.0.2",
    "kysely": "^0.29.6",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
