# Copy to .env and fill in real values. Never commit .env.
# Backend runtime configuration only — no payment/crypto/wallet variables exist here or
# anywhere in this project's scope.

# Standard libpq connection string. The backend connects as the restricted bakhta_app
# runtime role, never as the migration/owner role.
DATABASE_URL=postgresql://bakhta_app:CHANGE_ME@localhost:5432/bakhta

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --- Session policy (Authorization: Bearer <opaque_session_token>, no cookies) ---
# Admin sessions are deliberately shorter-lived than user sessions (spec requirement).
SESSION_USER_IDLE_MINUTES=60
SESSION_USER_ABSOLUTE_HOURS=336
SESSION_ADMIN_IDLE_MINUTES=15
SESSION_ADMIN_ABSOLUTE_HOURS=8

# --- Login rate limiting (durable, backed by the auth_attempts table) ---
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# --- Orders: dev-only order confirmation (payment is deferred) ---
# Double-guarded: the route also checks NODE_ENV !== 'production' regardless of this flag.
# Leave false unless you are actively exercising the purchase flow locally/in tests.
DEV_ORDER_CONFIRMATION_ENABLED=false

# --- CORS: explicit local frontend origin(s) only, never a wildcard ---
# Comma-separated if you need more than one (e.g. localhost + 127.0.0.1).
CORS_ORIGINS=http://localhost:3001

# --- Used only by scripts/seed.ts (see ../seeds/0001_roles_and_bootstrap_admin.sql) ---
# Required the first time seeds run against a fresh database. No default is provided
# deliberately — the seed script refuses to run without these.
BAKHTA_BOOTSTRAP_ADMIN_EMAIL=
BAKHTA_BOOTSTRAP_ADMIN_NUMBER=
