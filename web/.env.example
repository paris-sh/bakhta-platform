# Copy to .env.local and adjust if needed. Never commit .env.local.

# Real local Fastify API — must match the backend's CORS_ORIGINS allowlist.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# When true, guest checkout automatically calls the backend's dev-only order-confirmation
# endpoint right after order creation (payment is deferred in this build stage). This must
# stay false against any backend where DEV_ORDER_CONFIRMATION_ENABLED is not also true.
NEXT_PUBLIC_DEMO_MODE=true
